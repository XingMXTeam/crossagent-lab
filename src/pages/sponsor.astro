---
import BaseLayout from '../layouts/BaseLayout.astro';

const listingPay = 'https://buy.stripe.com/9B66oH9qRcSjeDg75m6AM03';
const newsletterPay = 'https://buy.stripe.com/7sYfZh32t5pRfHkdtK6AM04';
const foundingPay = 'https://buy.stripe.com/cNi7sLeLb4lN7aO9du6AM02';
const inbox = 'me@maoxunxing.com';
const listingMail = `mailto:${inbox}?subject=${encodeURIComponent('CrossAgent Listing Boost')}`;
const newsletterMail = `mailto:${inbox}?subject=${encodeURIComponent('CrossAgent Newsletter Insert')}`;
const foundingMail = `mailto:${inbox}?subject=${encodeURIComponent('CrossAgent Lab Sponsorship Question')}`;
---
<BaseLayout
  title="赞助 — CrossAgent Lab"
  description="CrossAgent Lab 赞助：用例推广 $49/30天，简报插页 $99/期，Founding $349/月。流量未稳不报虚数；用例排序不出售。"
  canonicalPath="/sponsor/"
>
  <section class="hero-simple sponsor-hero wrap">
    <h1>赞助 CrossAgent Lab</h1>
    <p class="honest-strip panel">
      <strong>诚实页。</strong>流量尚未稳定，不公布 UV 或打开率。自然排序与编辑位不出售。
      <span class="en">No vanity UV or open rate. Organic rank and editorial slots are not for sale.</span>
    </p>
  </section>

  <section class="section sponsor-main wrap">
    <p id="boost-context" class="panel boost-context" hidden></p>

    <article class="panel tier-card sponsor-primary" id="listing">
      <h3>Boost · 用例推广</h3>
      <p class="price-line">$49 <span class="price-unit">/ 30 天</span></p>
      <div class="cta-row">
        <a
          id="listing-pay"
          class="btn"
          href={listingPay}
          data-base-href={listingPay}
          target="_blank"
          rel="noopener noreferrer sponsored"
        >购买用例推广</a>
      </div>
      <p class="muted-note">从用例页「推广此用例」进入，结账带上该条。</p>
    </article>

    <div class="panel buy-points">
      <h2 id="buy-points-heading">买到 / 买不到 / 付完</h2>
      <div class="buy-points-scroll" tabindex="0" aria-labelledby="buy-points-heading">
        <table class="buy-points-table">
          <caption class="sr-only">Boost、简报、Founding：买到、买不到、付完</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">项目</span></th>
              <th scope="col">Boost <span class="buy-unit">$49 / 30 天</span></th>
              <th scope="col">简报 <span class="buy-unit">$99 / 期</span></th>
              <th scope="col">Founding <span class="buy-unit">$349 / 月</span></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">买到</th>
              <td>一条用例的赞助位，30 天（已有用例，或审过的公开来源）。标 Sponsored，展示品牌名和链接。</td>
              <td>一期周报一个赞助插槽：品牌名、约 40 字 pitch、一个链接。</td>
              <td>首页底部赞助条（品牌名、约 40 字 pitch、链接），以及周报一行 Sponsored by（简报开通后，按月持续）。</td>
            </tr>
            <tr>
              <th scope="row">买不到</th>
              <td>自然排序、编辑位、「已验证」徽章、曝光或 UV。</td>
              <td>打开率、订阅人数、首页位、多期打包。</td>
              <td>同时多位首页赞助、自然排序、流量数字。</td>
            </tr>
            <tr>
              <th scope="row">付完</th>
              <td>邮件 {inbox}：品牌名、链接、用例 URL。排期上线并标 Sponsored。</td>
              <td>邮件 {inbox}：品牌名、pitch、链接、希望期次。排入该期。</td>
              <td>邮件 {inbox}：品牌名、pitch、链接。确认档期后上首页；有人在播则从上一档结束后开始。</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="sponsor-grid">
      <article class="panel tier-card" id="newsletter">
        <h3>简报插页</h3>
        <p class="price-line">$99 <span class="price-unit">/ 期</span></p>
        <div class="cta-row">
          <a
            class="btn"
            href={newsletterPay}
            target="_blank"
            rel="noopener noreferrer sponsored"
          >购买简报插页</a>
        </div>
      </article>

      <article class="panel tier-card" id="founding">
        <h3>Founding 月赞助</h3>
        <p class="price-line">$349 <span class="price-unit">/ 月</span></p>
        <div class="cta-row">
          <a
            class="btn"
            href={foundingPay}
            target="_blank"
            rel="noopener noreferrer sponsored"
          >立即赞助</a>
          <a class="btn secondary" href={foundingMail}>邮件询 ¥2,500</a>
        </div>
        <p class="muted-note">早期启动价，满员后涨价。</p>
      </article>
    </div>

    <div class="sponsor-grid">
      <div class="panel">
        <h3>买不到</h3>
        <p>「已验证」徽章不出售。付费位标 Sponsored。</p>
      </div>
      <div class="panel">
        <h3>付完</h3>
        <ol class="sponsor-steps">
          <li>在 Stripe 付美元。本页不收集卡号。</li>
          <li>
            按上表发到 {inbox}：
            <a id="listing-mail" href={listingMail}>Boost</a>、
            <a href={newsletterMail}>简报</a>、
            <a href={foundingMail}>Founding</a>。
          </li>
          <li>核对后按档期上线，标 Sponsored。不改写用例事实。</li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ contactInbox: inbox }}>
  (function () {
    var params = new URLSearchParams(location.search);
    var slug = params.get('case') || '';
    if (!/^[a-z0-9-]{1,80}$/.test(slug)) return;

    var note = document.getElementById('boost-context');
    if (note) {
      note.hidden = false;
      var link = document.createElement('a');
      link.href = '/cases/' + slug + '/';
      link.textContent = slug;
      note.append('正在推广此用例 / Boost this case: ');
      note.append(link);
      note.append('。下面的「用例推广」结账会带上这条用例标识。');
    }

    var pay = document.getElementById('listing-pay');
    if (pay) {
      var base = pay.getAttribute('data-base-href') || pay.href;
      var url = new URL(base);
      url.searchParams.set('client_reference_id', slug);
      pay.href = url.toString();
    }

    var mail = document.getElementById('listing-mail');
    if (mail) {
      var body = '用例 slug: ' + slug + '\n用例链接: ' + location.origin + '/cases/' + slug + '/\n\n品牌名:\n链接:\n';
      mail.href = 'mailto:' + contactInbox + '?subject=' + encodeURIComponent('CrossAgent Listing Boost: ' + slug) + '&body=' + encodeURIComponent(body);
    }
  })();
</script>
