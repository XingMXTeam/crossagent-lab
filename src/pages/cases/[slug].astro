---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VoteButton from '../../components/VoteButton.astro';
import { categoryMeta } from '../../content/config';
import { agentCode, agentColor, formatDateNice, isNew, primaryAgent } from '../../lib/agents';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({ params: { slug: c.slug }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const cat = categoryMeta[d.category];
const dateStr = formatDateNice(d.date);
const agent = primaryAgent(d.agents);
const code = agentCode(agent);
const color = agentColor(agent);
const fresh = isNew(d.date);
---
<BaseLayout title={`${d.title} — CrossAgent Lab`} description={d.summary} canonicalPath={`/cases/${entry.slug}/`}>
  <article class="wrap">
    <div class="article-head">
      <p class="crumb">
        <a href="/">用例</a> · <a href={`/categories/${d.category}/`}>{cat.zh}</a>
      </p>
      <div class="article-title-row">
        <div class="case-avatar" style={`background:${color}`} aria-hidden="true">{code}</div>
        <div class="article-title-copy">
          <h1>{d.title}</h1>
          {d.titleEn && <p class="title-en">{d.titleEn}</p>}
        </div>
      </div>
      <p class="lead">{d.summary}</p>
      <div class="case-meta" style="margin-bottom:0.5rem;">
        <span>{d.agents.join(' · ')}</span>
        {fresh && <><span class="sep">·</span><span class="badge-new">New</span></>}
        <span class="sep">·</span>
        {d.sourceUrl ? (
          <a href={d.sourceUrl} target="_blank" rel="noopener noreferrer">{d.source}</a>
        ) : (
          <span>{d.source}</span>
        )}
        <span class="sep">·</span>
        <span>{dateStr}{d.dateNote ? ` · ${d.dateNote}` : ''}</span>
        {d.tools.length > 0 && (
          <>
            <span class="sep">·</span>
            <span>工具：{d.tools.join(' · ')}</span>
          </>
        )}
      </div>
      <div class="detail-actions">
        <VoteButton id={entry.slug} variant="button" />
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>

    <section class="prompt-section" id="prompt">
      <div class="prompt-head">
        <h2>可复制 Prompt</h2>
        {d.sourceUrl && (
          <a class="btn read-original" href={d.sourceUrl} target="_blank" rel="noopener noreferrer">
            <span>读原文</span>
            <span class="read-original-en">Read the original</span>
          </a>
        )}
      </div>
      <div class="prompt-box">
        <div class="prompt-actions">
          <button class="copy-btn" type="button" data-copy>
            <span data-copy-label>复制 Prompt</span>
          </button>
          <button class="share-btn" type="button" data-share-title={d.title} data-share-url={`/cases/${entry.slug}/`}>
            <span data-share-label>分享</span>
          </button>
        </div>
        <pre id="prompt-text">{d.prompt}</pre>
      </div>
    </section>

    <p class="detail-foot">
      <a href="/">← 全部用例</a>
      <span class="sep">·</span>
      <a href={`/categories/${d.category}/`}>{cat.zh}</a>
      <span class="sep">·</span>
      <VoteButton id={entry.slug} />
    </p>
  </article>
  <script is:inline>
    document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const label = btn.querySelector('[data-copy-label]');
      const text = document.getElementById('prompt-text')?.textContent || '';
      const setLabel = (value) => {
        if (label) label.textContent = value;
      };
      const reset = () => {
        btn.classList.remove('is-copied', 'is-error');
        setLabel('复制 Prompt');
      };
      btn.classList.add('is-copied');
      btn.classList.remove('is-error');
      setLabel('✓ 已复制');
      try {
        await navigator.clipboard.writeText(text);
        setTimeout(reset, 2600);
      } catch {
        btn.classList.remove('is-copied');
        btn.classList.add('is-error');
        setLabel('请手动复制');
        setTimeout(reset, 2600);
      }
    });
  </script>
</BaseLayout>
