---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VoteButton from '../../components/VoteButton.astro';
import SaveButton from '../../components/SaveButton.astro';
import { categoryMeta } from '../../content/config';
import { agentCode, agentColor, formatDateNice, isNew, primaryAgent } from '../../lib/agents';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({ params: { slug: c.slug }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const cat = categoryMeta[d.category];
const dateStr = formatDateNice(d.date);
const agent = primaryAgent(d.agents);
const fresh = isNew(d.date);
const all = await getCollection('cases');
const agentCount = all.filter((c) => c.data.agents.includes(agent)).length;
const catCount = all.filter((c) => c.data.category === d.category).length;
---
<BaseLayout title={`${d.title} — CrossAgent Lab`} description={d.summary} canonicalPath={`/cases/${entry.slug}/`}>
  <article>
    <header class="article-head">
      <p class="kicker"><a href={`/categories/${d.category}/`}>{cat.zh}</a></p>
      <h1>{d.title}</h1>
      {d.titleEn && <p class="title-en">{d.titleEn}</p>}
      <p class="lead">{d.summary}</p>
      <div class="with-agents">
        <span>用</span>
        {d.agents.map((name) => (
          <a class="agent-pill" href={`/?agent=${encodeURIComponent(name)}`}>
            <span class="mark mark-xs" style={`background:${agentColor(name)}`} aria-hidden="true">{agentCode(name)}</span>
            {name}
          </a>
        ))}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <section class="prompt-section" id="prompt">
      <div class="prompt-box" data-prompt-box>
        <div class="prompt-head">
          <p class="prompt-title">可复制 Prompt <span>用 {agent}</span></p>
          <button class="copy-btn" type="button" data-copy aria-live="polite">复制 Prompt</button>
        </div>
        <pre id="prompt-text">{d.prompt}</pre>
      </div>
    </section>

    <div class="detail-actions">
      {d.sourceUrl && (
        <a class="btn" href={d.sourceUrl} target="_blank" rel="noopener noreferrer">
          读原文
          <span class="btn-en">Read the original</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      <VoteButton id={entry.slug} variant="button" />
      <SaveButton id={entry.slug} title={d.title} url={`/cases/${entry.slug}/`} variant="button" />
      <a class="btn secondary" href={`/sponsor/?case=${encodeURIComponent(entry.slug)}#listing`}>
        推广此用例
        <span class="btn-en">Boost this case</span>
      </a>
      <button class="btn secondary" type="button" data-share-title={d.title} data-share-url={`/cases/${entry.slug}/`}>分享</button>
    </div>
    <p class="source-line">
      来源：
      {d.sourceUrl ? (
        <a href={d.sourceUrl} target="_blank" rel="noopener noreferrer">{d.source}</a>
      ) : (
        d.source
      )}
      {fresh && <> · <span class="badge-new">New</span></>}
      · {dateStr}{d.dateNote ? ` · ${d.dateNote}` : ''}
      {d.tools.length > 0 && <> · 工具：{d.tools.join(' · ')}</>}
    </p>

    <nav class="keep-browsing" aria-label="继续浏览">
      <h2>继续看</h2>
      <a href={`/?agent=${encodeURIComponent(agent)}`}>全部 {agentCount} 条 {agent}</a>
      <a href={`/categories/${d.category}/`}>全部 {catCount} 条 {cat.zh}</a>
    </nav>
  </article>
  <script is:inline>
    document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const text = document.getElementById('prompt-text')?.textContent || '';
      const box = document.querySelector('[data-prompt-box]');
      const done = () => {
        btn.classList.add('is-copied');
        box?.classList.add('is-copied');
        btn.textContent = '已复制';
        setTimeout(() => {
          btn.classList.remove('is-copied');
          box?.classList.remove('is-copied');
          btn.textContent = '复制 Prompt';
        }, 2000);
      };
      try {
        await navigator.clipboard.writeText(text);
        done();
      } catch {
        const pre = document.getElementById('prompt-text');
        if (pre) {
          const range = document.createRange();
          range.selectNodeContents(pre);
          const sel = getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        btn.textContent = '已选中，请手动复制';
        setTimeout(() => { btn.textContent = '复制 Prompt'; }, 2000);
      }
    });
  </script>
</BaseLayout>
