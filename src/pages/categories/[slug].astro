---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { categories, categoryMeta } from '../../content/config';

export async function getStaticPaths() {
  return categories.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const meta = categoryMeta[slug as keyof typeof categoryMeta];
const cases = (await getCollection('cases'))
  .filter((c) => c.data.category === slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout layout="feed" title={`${meta.zh} — CrossAgent Lab`} description={meta.desc} canonicalPath={`/categories/${slug}/`}>
  <header class="page-head">
    <p class="page-kicker">分类</p>
    <h1>{meta.zh}</h1>
    <p class="title-en">{meta.en}</p>
    <p class="lead">{meta.desc}</p>
    <p class="feed-sub">{cases.length} 条用例</p>
  </header>
  <section class="cat-section cat-section--page" data-case-section>
    {cases.length === 0 && <p class="empty-note">该分类暂无用例，后续补充。</p>}
    <ul class="case-list">
      {cases.map((c) => (
        <CaseCard
          href={`/cases/${c.slug}/`}
          title={c.data.title}
          summary={c.data.summary}
          category={c.data.category}
          source={c.data.source}
          sourceUrl={c.data.sourceUrl}
          date={c.data.date}
          agents={c.data.agents}
        />
      ))}
    </ul>
  </section>
</BaseLayout>
