---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { categories, categoryMeta } from '../../content/config';

export async function getStaticPaths() {
  return categories.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const meta = categoryMeta[slug as keyof typeof categoryMeta];
const cases = (await getCollection('cases'))
  .filter((c) => c.data.category === slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={`${meta.zh} — CrossAgent Lab`} description={meta.desc} canonicalPath={`/categories/${slug}/`}>
  <section class="hero-simple wrap">
    <h1>{meta.zh}</h1>
    <p class="en">{meta.en}</p>
    <p class="lead">{meta.desc}</p>
  </section>
  <section class="feed-section wrap" style="padding-top:0;">
    <p class="feed-sub">{cases.length} 条用例</p>
    <ul class="case-list">
      {cases.length === 0 && (
        <li><p class="case-summary" style="padding:1rem 0;">该分类暂无用例，后续补充。</p></li>
      )}
      {cases.map((c) => (
        <CaseCard
          href={`/cases/${c.slug}/`}
          title={c.data.title}
          summary={c.data.summary}
          category={c.data.category}
          source={c.data.source}
          sourceUrl={c.data.sourceUrl}
          date={c.data.date}
          agents={c.data.agents}
        />
      ))}
    </ul>
    <p style="margin:1.5rem 0 2rem;"><a href="/">← 全部用例</a></p>
  </section>
</BaseLayout>
