---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import { categories, categoryMeta } from '../content/config';
import { formatFeedSubline, isNew } from '../lib/agents';
import MailchimpSubscribeForm from '../components/MailchimpSubscribeForm.astro';

const cases = (await getCollection('cases')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestDate = cases[0]?.data.date ?? new Date();
const feedSubline = formatFeedSubline(latestDate);

const newCases = cases.filter((c) => isNew(c.data.date, 30));
const feedCases = newCases.length >= 3 ? newCases : cases.slice(0, Math.min(8, cases.length));
const feedIds = new Set(feedCases.map((c) => c.id));
const feedHeading =
  newCases.length >= 3 ? `${newCases.length} 条较新用例` : '最新用例';
const feedKicker = newCases.length >= 3 ? '较新' : '最新';
---
<BaseLayout
  layout="feed"
  title="CrossAgent Lab — 别人正在用的跨境 Agent 做法"
  description="别人正在用的跨境 Agent 做法。偷一个灵感。 Real things sellers do with AI agents. Steal an idea."
  canonicalPath="/"
>
  <section class="signal-block" id="latest" data-case-section>
    <div class="signal-head">
      <div>
        <h2>{feedHeading}</h2>
        <p class="feed-sub">{feedSubline}</p>
      </div>
      <p class="signal-kicker">{feedKicker}</p>
    </div>
    <ul class="case-list">
      {feedCases.map((c) => (
        <CaseCard
          href={`/cases/${c.slug}/`}
          title={c.data.title}
          summary={c.data.summary}
          category={c.data.category}
          source={c.data.source}
          sourceUrl={c.data.sourceUrl}
          date={c.data.date}
          agents={c.data.agents}
        />
      ))}
    </ul>
  </section>

  {categories.map((id) => {
    const m = categoryMeta[id];
    const catCases = cases.filter((c) => c.data.category === id);
    if (catCases.length === 0) return null;
    let list = catCases.filter((c) => !feedIds.has(c.id));
    if (list.length === 0) list = catCases;
    list = list.slice(0, 4);
    return (
      <section class="cat-section" data-case-section>
        <h2>{m.zh}</h2>
        <p class="cat-desc">{m.en} · {m.desc}</p>
        <ul class="case-list">
          {list.map((c) => (
            <CaseCard
              href={`/cases/${c.slug}/`}
              title={c.data.title}
              summary={c.data.summary}
              category={c.data.category}
              source={c.data.source}
              sourceUrl={c.data.sourceUrl}
              date={c.data.date}
              agents={c.data.agents}
            />
          ))}
        </ul>
        <a class="cat-link" href={`/categories/${id}/`}>查看全部 {m.zh} →</a>
      </section>
    );
  })}

  <section class="cta-band" id="subscribe">
    <div>
      <h2>每周精选跨境 Agent 用例</h2>
      <p>每周 1 封：新用例与可复制 Prompt。加入 mxteam 名单并打上 CrossAgent Lab 标签，可随时退订。</p>
    </div>
    <MailchimpSubscribeForm variant="compact" formId="mc-home" />
  </section>
</BaseLayout>
