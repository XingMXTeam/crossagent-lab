---
import BaseLayout from '../layouts/BaseLayout.astro';
import MailchimpSubscribeForm from '../components/MailchimpSubscribeForm.astro';
---
<BaseLayout
  title="简报订阅 — CrossAgent Lab"
  description="每周精选跨境 Agent 用例"
  canonicalPath="/newsletter/"
>
  <section class="hero-simple wrap">
    <h1>每周精选跨境 Agent 用例</h1>
    <p class="lead">每周 1 封：新用例、可复制 Prompt、中后台与广告实操 tips。不做噪音。</p>
    <p class="en">One email a week — new playbooks and prompts for cross-border ops.</p>
  </section>

  <section class="section wrap" id="subscribe">
    <div class="panel">
      <h3>订阅周报</h3>
      <p>填邮箱即可加入 mxteam 名单，并打上 CrossAgent Lab 标签。可随时退订。</p>
      <p class="en" style="margin-top:0.35rem;">Joins the mxteam list with tag CrossAgent Lab. Unsubscribe anytime.</p>
      <MailchimpSubscribeForm variant="full" formId="mc-newsletter" />
      <p class="muted-note" style="margin-top:0.75rem;">由 Mailchimp 处理邮箱 · 提交后跳转确认页 · 本站不单独存表。</p>
    </div>

    <div class="panel">
      <h3>你会收到什么</h3>
      <ul>
        <li>本周新增 / 精选跨境 Agent 用例（附原文链接）</li>
        <li>可复制 Prompt 或工作流要点</li>
        <li>偶尔：工具与运营 tips（广告、刊登、客服、中后台）</li>
      </ul>
    </div>
  </section>
</BaseLayout>
