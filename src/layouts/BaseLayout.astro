---
import '../styles/global.css';
import SponsorBar from '../components/SponsorBar.astro';
import AgentChips from '../components/AgentChips.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  showAgents?: boolean;
  agentStats?: { name: string; count: number }[];
  activeAgent?: string | null;
  metaLine?: boolean;
  caseCount?: number;
  updatedLabel?: string;
  noindex?: boolean;
  showTagline?: boolean;
}
const {
  title,
  description = '别人正在用的跨境 Agent 做法。偷一个灵感。 Real things sellers do with AI agents. Steal an idea.',
  canonicalPath = '/',
  showAgents = false,
  agentStats = [],
  activeAgent = null,
  metaLine = false,
  caseCount = 0,
  updatedLabel = '',
  noindex = false,
  showTagline = false,
} = Astro.props;
const site = 'https://crossagent.maoxunxing.com';
const canonical = new URL(canonicalPath, site).href;
const ogImage = new URL('/og.png', site).href;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="CrossAgent Lab RSS" href="/rss.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="CrossAgent Lab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fafafa" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class:list={['brand', { 'has-tagline': showTagline }]} href="/">
          <img class="brand-mark" src="/logo.svg" width="32" height="32" alt="" />
          crossagent<span>.lab</span>
        </a>
        {showTagline && (
          <p class="brand-tagline">
            <span class="zh">别人正在用的跨境 Agent 做法。偷一个灵感。</span>
            <span class="en">Real things sellers do with AI agents. Steal an idea.</span>
          </p>
        )}
        {showAgents && agentStats.length > 0 && (
          <AgentChips agents={agentStats} active={activeAgent} totalCases={caseCount} />
        )}
        {metaLine && (
          <p class="site-meta">
            <strong class="meta-count">{caseCount}</strong> 条用例
            <span class="dot">·</span>
            Updated {updatedLabel}
            <span class="dot">·</span>
            Sources: 公开网页与社群
          </p>
        )}
        <nav class="site-nav" aria-label="站点">
          <a href="/">用例</a>
          <a href="/submit/">提交</a>
          <a href="/newsletter/">简报</a>
          <a href="/sponsor/">赞助</a>
          <a href="/about/">关于</a>
          <a href="/about/#privacy">隐私</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <SponsorBar />
    <footer class="site-footer">
      <div class="wrap inner">
        <div>
          <strong>CrossAgent Lab</strong> · 毛训星 / Momo（杭州）
          <br />宿主于 <code>crossagent.maoxunxing.com</code>
        </div>
        <div>
          <a href="mailto:xunxing1989@gmail.com">xunxing1989@gmail.com</a>
          <span class="dot">·</span>
          <a href="/sponsor/">赞助</a>
          <span class="dot">·</span>
          <a href="/about/#privacy">隐私</a>
          <span class="dot">·</span>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.querySelectorAll('[data-share-title]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const title = btn.getAttribute('data-share-title') || '';
          const path = btn.getAttribute('data-share-url') || '/';
          const url = new URL(path, location.origin).href;
          const label = btn.querySelector('[data-share-label]');
          const setLabel = (value) => {
            if (label) label.textContent = value;
          };
          try {
            if (navigator.share) {
              await navigator.share({ title, url });
            } else {
              await navigator.clipboard.writeText(url);
              btn.classList.add('is-copied');
              setLabel('已复制链接');
              setTimeout(() => {
                btn.classList.remove('is-copied');
                setLabel('分享');
              }, 1600);
            }
          } catch { /* user cancelled */ }
        });
      });
      // Client filter for agent chips when ?agent= is present (static site)
      (function () {
        const params = new URLSearchParams(location.search);
        const agent = params.get('agent');
        if (!agent) return;
        document.querySelectorAll('.agent-chip').forEach((el) => {
          el.classList.toggle('active', el.getAttribute('data-agent') === agent || (!el.getAttribute('data-agent') && !agent));
        });
        const toggle = document.querySelector('[data-agent-filter-toggle]');
        const toggleLabel = document.querySelector('[data-agent-filter-label]');
        if (toggle) toggle.classList.add('is-filtering');
        if (toggleLabel) toggleLabel.textContent = agent;
        document.querySelectorAll('.case-list > li').forEach((li) => {
          const meta = li.querySelector('.case-meta');
          if (!meta) return;
          const text = meta.textContent || '';
          li.style.display = text.includes(agent) ? '' : 'none';
        });
        const sections = document.querySelectorAll('.feed-section, .cat-section');
        let any = false;
        sections.forEach((section) => {
          const cards = section.querySelectorAll('.case-list > li');
          let visible = 0;
          cards.forEach((li) => {
            if (li.style.display === 'none') return;
            if (li.querySelector('.case-card')) visible += 1;
          });
          if (visible === 0) section.classList.add('is-filtered-out');
          else any = true;
        });
        if (!any) {
          const main = document.querySelector('main');
          if (!main || main.querySelector('.filter-empty')) return;
          const note = document.createElement('p');
          note.className = 'filter-empty wrap';
          const name = document.createElement('strong');
          name.textContent = agent;
          note.append('没有「');
          note.append(name);
          note.append('」的用例。');
          const link = document.createElement('a');
          link.href = location.pathname;
          link.textContent = '查看全部';
          note.append(' ');
          note.append(link);
          main.prepend(note);
        }
      })();
      (function () {
        var buttons = document.querySelectorAll('[data-vote]');
        if (!buttons.length) return;
        var storeKey = 'crossagent-votes';
        var live = document.createElement('p');
        live.className = 'sr-only';
        live.setAttribute('aria-live', 'polite');
        document.body.appendChild(live);
        function readStore() {
          try {
            var raw = JSON.parse(localStorage.getItem(storeKey) || '{}');
            return raw && typeof raw === 'object' ? raw : {};
          } catch (e) {
            return {};
          }
        }
        function writeStore(store) {
          try { localStorage.setItem(storeKey, JSON.stringify(store)); } catch (e) {}
        }
        function paint(counts, opts) {
          var mine = (opts && opts.mine) || readStore();
          var bumpId = opts && opts.bumpId;
          buttons.forEach(function (btn) {
            var id = btn.getAttribute('data-vote') || '';
            var n = counts && typeof counts[id] === 'number' ? counts[id] : 0;
            var on = !!mine[id];
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            btn.classList.toggle('is-on', on);
            btn.setAttribute('aria-label', (on ? '已想要' : '我想要这个') + ' ' + n);
            var label = btn.querySelector('.vote-label');
            if (label) label.textContent = on ? '已想要' : '我想要这个';
            var countEl = btn.querySelector('[data-vote-count]');
            if (!countEl) return;
            var next = String(n);
            if (bumpId === id && countEl.textContent !== next) {
              countEl.classList.remove('is-bump');
              void countEl.offsetWidth;
              countEl.classList.add('is-bump');
            }
            countEl.textContent = next;
          });
        }
        function applyCount(map, id, value) {
          if (value > 0) map[id] = value;
          else delete map[id];
        }
        var counts = {};
        var localEdits = {};
        function mergeFresh(incoming) {
          var next = Object.assign({}, incoming);
          Object.keys(localEdits).forEach(function (id) {
            if (localEdits[id] > 0) next[id] = localEdits[id];
            else delete next[id];
          });
          return next;
        }
        paint(counts);
        fetch('/api/votes', { headers: { accept: 'application/json' } })
          .then(function (res) { return res.ok ? res.json() : null; })
          .then(function (data) {
            if (!data || typeof data !== 'object' || Array.isArray(data)) return;
            var incoming = data.counts && typeof data.counts === 'object' ? data.counts : data;
            counts = mergeFresh(incoming);
            var busy = false;
            buttons.forEach(function (btn) {
              if (btn.getAttribute('data-busy') === '1') busy = true;
            });
            if (!busy) paint(counts);
          })
          .catch(function () {});
        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-vote');
            if (!id || btn.getAttribute('data-busy') === '1') return;
            var mine = readStore();
            var on = !mine[id];
            var optimisticMine = Object.assign({}, mine);
            if (on) optimisticMine[id] = true;
            else delete optimisticMine[id];
            var optimisticCounts = Object.assign({}, counts);
            var nextN = Math.max(0, (optimisticCounts[id] || 0) + (on ? 1 : -1));
            applyCount(optimisticCounts, id, nextN);
            buttons.forEach(function (other) {
              if (other.getAttribute('data-vote') === id) {
                other.setAttribute('data-busy', '1');
                other.classList.remove('is-error');
              }
            });
            paint(optimisticCounts, { mine: optimisticMine, bumpId: id });
            fetch('/api/votes', {
              method: 'POST',
              headers: { 'content-type': 'application/json', accept: 'application/json' },
              body: JSON.stringify({ id: id, on: on }),
            })
              .then(function (res) {
                if (!res.ok) throw new Error('vote');
                return res.json();
              })
              .then(function (data) {
                if (typeof data.count === 'number') applyCount(counts, id, data.count);
                localEdits[id] = counts[id] || 0;
                if (on) mine[id] = true;
                else delete mine[id];
                writeStore(mine);
                paint(counts, { bumpId: id });
                live.textContent = (on ? '已想要' : '已取消') + ' ' + (counts[id] || 0);
              })
              .catch(function () {
                paint(counts);
                buttons.forEach(function (other) {
                  if (other.getAttribute('data-vote') !== id) return;
                  other.classList.add('is-error');
                  var label = other.querySelector('.vote-label');
                  if (label) label.textContent = '请重试';
                });
                live.textContent = '未记下，请重试';
                setTimeout(function () {
                  buttons.forEach(function (other) {
                    if (other.getAttribute('data-vote') === id) other.classList.remove('is-error');
                  });
                  paint(counts);
                }, 1600);
              })
              .then(function () {
                buttons.forEach(function (other) {
                  if (other.getAttribute('data-vote') === id) other.removeAttribute('data-busy');
                });
              });
          });
        });
      })();
    </script>
  </body>
</html>
