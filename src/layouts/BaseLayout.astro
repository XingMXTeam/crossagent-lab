---
import '../styles/global.css';
import SponsorBar from '../components/SponsorBar.astro';
import AgentChips from '../components/AgentChips.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  showAgents?: boolean;
  agentStats?: { name: string; count: number }[];
  activeAgent?: string | null;
  metaLine?: boolean;
  caseCount?: number;
  updatedLabel?: string;
  noindex?: boolean;
  showTagline?: boolean;
}
const {
  title,
  description = '别人正在用的跨境 Agent 做法。偷一个灵感。 Real things sellers do with AI agents. Steal an idea.',
  canonicalPath = '/',
  showAgents = false,
  agentStats = [],
  activeAgent = null,
  metaLine = false,
  caseCount = 0,
  updatedLabel = '',
  noindex = false,
  showTagline = false,
} = Astro.props;
const site = 'https://crossagent.maoxunxing.com';
const canonical = new URL(canonicalPath, site).href;
const ogImage = new URL('/og.png', site).href;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="CrossAgent Lab RSS" href="/rss.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="CrossAgent Lab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fafafa" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class:list={['brand', { 'has-tagline': showTagline }]} href="/">
          <img class="brand-mark" src="/logo.svg" width="28" height="28" alt="" />
          crossagent<span>.lab</span>
        </a>
        {showTagline && (
          <p class="brand-tagline">
            <span class="zh">别人正在用的跨境 Agent 做法。偷一个灵感。</span>
            <span class="en">Real things sellers do with AI agents. Steal an idea.</span>
          </p>
        )}
        {showAgents && agentStats.length > 0 && (
          <AgentChips agents={agentStats} active={activeAgent} totalCases={caseCount} />
        )}
        {metaLine && (
          <p class="site-meta">
            <strong class="meta-count">{caseCount}</strong> 条用例
            Updated {updatedLabel}
            Sources: 公开网页与社群
            <span class="dot">·</span>
            <a href="/rss.xml">RSS</a>
            <span class="dot">·</span>
            <a href="/sponsor/">赞助</a>
            <span class="dot">·</span>
            <a href="/about/#privacy">隐私</a>
            <span class="dot">·</span>
            <a href="/">用例</a>
            <span class="dot">·</span>
            <a href="/submit/">提交</a>
            <span class="dot">·</span>
            <a href="/newsletter/">简报</a>
            <span class="dot">·</span>
            <a href="/about/">关于</a>
          </p>
        )}
        {!metaLine && (
          <p class="site-meta">
            <a href="/">用例</a>
            <span class="dot">·</span>
            <a href="/submit/">提交</a>
            <span class="dot">·</span>
            <a href="/newsletter/">简报</a>
            <span class="dot">·</span>
            <a href="/sponsor/">赞助</a>
            <span class="dot">·</span>
            <a href="/about/">关于</a>
            <span class="dot">·</span>
            <a href="/about/#privacy">隐私</a>
            <span class="dot">·</span>
            <a href="/rss.xml">RSS</a>
          </p>
        )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <SponsorBar />
    <footer class="site-footer">
      <div class="wrap inner">
        <div>
          <strong>CrossAgent Lab</strong> · 毛训星 / Momo（杭州）
          <br />宿主于 <code>crossagent.maoxunxing.com</code>
        </div>
        <div>
          <a href="mailto:xunxing1989@gmail.com">xunxing1989@gmail.com</a>
          <span class="dot">·</span>
          <a href="/sponsor/">赞助</a>
          <span class="dot">·</span>
          <a href="/about/#privacy">隐私</a>
          <span class="dot">·</span>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.querySelectorAll('[data-share-title]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const title = btn.getAttribute('data-share-title') || '';
          const path = btn.getAttribute('data-share-url') || '/';
          const url = new URL(path, location.origin).href;
          try {
            if (navigator.share) {
              await navigator.share({ title, url });
            } else {
              await navigator.clipboard.writeText(url);
              const prev = btn.textContent;
              btn.textContent = '已复制链接';
              setTimeout(() => { btn.textContent = prev; }, 1500);
            }
          } catch { /* user cancelled */ }
        });
      });
      // Client filter for agent chips when ?agent= is present (static site)
      (function () {
        const params = new URLSearchParams(location.search);
        const agent = params.get('agent');
        if (!agent) return;
        document.querySelectorAll('.agent-chip').forEach((el) => {
          el.classList.toggle('active', el.getAttribute('data-agent') === agent || (!el.getAttribute('data-agent') && !agent));
        });
        document.querySelectorAll('.case-list > li').forEach((li) => {
          const meta = li.querySelector('.case-meta');
          if (!meta) return;
          const text = meta.textContent || '';
          li.style.display = text.includes(agent) ? '' : 'none';
        });
      })();
      (function () {
        var buttons = document.querySelectorAll('[data-vote]');
        if (!buttons.length) return;
        var storeKey = 'crossagent-votes';
        function readStore() {
          try {
            var raw = JSON.parse(localStorage.getItem(storeKey) || '{}');
            return raw && typeof raw === 'object' ? raw : {};
          } catch (e) {
            return {};
          }
        }
        function writeStore(store) {
          try { localStorage.setItem(storeKey, JSON.stringify(store)); } catch (e) {}
        }
        function paint(counts) {
          var mine = readStore();
          buttons.forEach(function (btn) {
            var id = btn.getAttribute('data-vote') || '';
            var n = counts && typeof counts[id] === 'number' ? counts[id] : 0;
            var on = !!mine[id];
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            btn.classList.toggle('is-on', on);
            var countEl = btn.querySelector('[data-vote-count]');
            if (countEl) countEl.textContent = String(n);
          });
        }
        var counts = {};
        paint(counts);
        fetch('/api/votes', { headers: { accept: 'application/json' } })
          .then(function (res) { return res.ok ? res.json() : null; })
          .then(function (data) {
            if (!data || typeof data !== 'object' || Array.isArray(data)) return;
            counts = data.counts && typeof data.counts === 'object' ? data.counts : data;
            paint(counts);
          })
          .catch(function () {});
        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-vote');
            if (!id || btn.getAttribute('data-busy') === '1') return;
            var mine = readStore();
            var on = !mine[id];
            btn.setAttribute('data-busy', '1');
            fetch('/api/votes', {
              method: 'POST',
              headers: { 'content-type': 'application/json', accept: 'application/json' },
              body: JSON.stringify({ id: id, on: on }),
            })
              .then(function (res) {
                if (!res.ok) throw new Error('vote');
                return res.json();
              })
              .then(function (data) {
                if (typeof data.count === 'number') counts[id] = data.count;
                if (on) mine[id] = true;
                else delete mine[id];
                writeStore(mine);
                paint(counts);
              })
              .catch(function () {})
              .then(function () { btn.removeAttribute('data-busy'); });
          });
        });
      })();
    </script>
  </body>
</html>
