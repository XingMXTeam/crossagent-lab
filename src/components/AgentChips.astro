---
import { agentCode, agentColor } from '../lib/agents';

interface Props {
  agents: { name: string; count: number }[];
}
const { agents } = Astro.props;
const limit = 8;
---
<div class="side-block">
  <div class="side-label-row">
    <h2>Agents</h2>
  </div>
  <ul class="side-list" data-agent-list>
    {agents.map((a, i) => (
      <li class:list={[{ 'is-extra': i >= limit }]}>
        <a class="side-link agent-row" href={`/?agent=${encodeURIComponent(a.name)}`} data-agent={a.name}>
          <span class="mark mark-sm" style={`background:${agentColor(a.name)}`} aria-hidden="true">{agentCode(a.name)}</span>
          <span class="side-name">{a.name}</span>
          <span class="mono-count">{a.count}</span>
        </a>
      </li>
    ))}
  </ul>
  {agents.length > limit && (
    <button type="button" class="show-all" data-show-agents data-count={agents.length}>
      显示全部 {agents.length}
    </button>
  )}
</div>
