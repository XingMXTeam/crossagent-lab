---
/**
 * Mailchimp embed → mxteam Audience + tag "CrossAgent Lab".
 * u/id from us5; tags=4555940 applies CrossAgent Lab.
 * On submit, also POSTs email to /api/newsletter-welcome (Resend sample)
 * then continues the normal Mailchimp form POST. Welcome failures never
 * block list signup.
 */
interface Props {
  variant?: 'full' | 'compact';
  formId?: string;
}
const { variant = 'full', formId = 'mc-embedded-subscribe-form' } = Astro.props;
const action =
  'https://gmail.us5.list-manage.com/subscribe/post?u=c3b0164459768548b7bef380c&id=1103acd526&f_id=000042edf0';
---
<form
  action={action}
  method="post"
  id={formId}
  name="mc-embedded-subscribe-form"
  class={variant === 'compact' ? 'mc-form mc-form-compact' : 'mc-form form-stack'}
  accept-charset="UTF-8"
  data-welcome-api="/api/newsletter-welcome"
>
  {variant === 'full' ? (
    <>
      <div class="form-field">
        <label for={`${formId}-EMAIL`}>邮箱 <span class="hint">必填</span></label>
        <input
          type="email"
          name="EMAIL"
          id={`${formId}-EMAIL`}
          required
          autocomplete="email"
          placeholder="you@example.com"
        />
      </div>
      <div class="form-field">
        <label for={`${formId}-FNAME`}>名字 <span class="hint">可选</span></label>
        <input
          type="text"
          name="FNAME"
          id={`${formId}-FNAME`}
          autocomplete="given-name"
          placeholder="怎么称呼你"
        />
      </div>
    </>
  ) : (
    <div class="form-inline">
      <label class="sr-only" for={`${formId}-EMAIL`}>邮箱</label>
      <input
        type="email"
        name="EMAIL"
        id={`${formId}-EMAIL`}
        required
        autocomplete="email"
        placeholder="邮箱"
      />
      <button type="submit" class="btn" name="subscribe" id={`${formId}-submit`}>订阅周报</button>
    </div>
  )}

  <input type="hidden" name="tags" value="4555940" />

  {/* Mailchimp honeypot — leave empty */}
  <div class="mc-honeypot" aria-hidden="true">
    <label for={`${formId}-honeypot`}>Leave blank</label>
    <input
      type="text"
      name="b_c3b0164459768548b7bef380c_1103acd526"
      id={`${formId}-honeypot`}
      tabindex="-1"
      value=""
      autocomplete="off"
    />
  </div>

  {variant === 'full' && (
    <div class="cta-row">
      <button type="submit" class="btn" name="subscribe" id={`${formId}-submit`}>订阅周报</button>
    </div>
  )}
</form>

<script is:inline define:vars={{ formId }}>
  (function () {
    var form = document.getElementById(formId);
    if (!form || form.dataset.welcomeBound) return;
    form.dataset.welcomeBound = '1';
    form.addEventListener('submit', function (ev) {
      if (form.dataset.welcomeDone === '1') return;
      var api = form.getAttribute('data-welcome-api');
      if (!api) return;
      var emailEl = form.querySelector('input[name="EMAIL"]');
      var nameEl = form.querySelector('input[name="FNAME"]');
      var email = emailEl && emailEl.value ? String(emailEl.value).trim() : '';
      if (!email) return;
      ev.preventDefault();
      var payload = { email: email };
      if (nameEl && nameEl.value) payload.name = String(nameEl.value).trim();
      var finish = function () {
        form.dataset.welcomeDone = '1';
        if (typeof form.requestSubmit === 'function') form.requestSubmit();
        else form.submit();
      };
      var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var timer = setTimeout(function () {
        if (ctrl) ctrl.abort();
        finish();
      }, 2500);
      fetch(api, {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(payload),
        credentials: 'same-origin',
        signal: ctrl ? ctrl.signal : undefined,
        keepalive: true,
      })
        .catch(function () {})
        .then(function () {
          clearTimeout(timer);
          finish();
        });
    });
  })();
</script>
