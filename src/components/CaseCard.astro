---
import { agentCode, agentColor, primaryAgent, formatDateMonthYear, isNew } from '../lib/agents';
import { categories } from '../content/config';
import VoteButton from './VoteButton.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  category: (typeof categories)[number];
  source: string;
  sourceUrl?: string;
  date: Date;
  agents: string[];
  showPromptLink?: boolean;
}
const { href, title, summary, source, sourceUrl, date, agents, showPromptLink = true } = Astro.props;
const agent = primaryAgent(agents);
const code = agentCode(agent);
const color = agentColor(agent);
const dateStr = formatDateMonthYear(date);
const fresh = isNew(date);
const promptHref = `${href}#prompt`;
const caseSlug = href.match(/\/cases\/([^/?#]+)\/?/)?.[1] ?? '';
const search = `${title} ${summary} ${agents.join(' ')} ${source}`.toLowerCase();
---
<li data-search={search} data-agents={agents.join('|')} data-fresh={fresh ? '1' : '0'}>
  <article class="case-row">
    <span class="mark case-mark" style={`background:${color}`} aria-hidden="true">{code}</span>
    <div class="case-body">
      <h3 class="case-title"><a href={href}>{title}</a></h3>
      <p class="case-summary">{summary}</p>
      <div class="case-meta">
        <a class="meta-agent" href={`/?agent=${encodeURIComponent(agent)}`}>
          <span class="mark-dot" style={`background:${color}`} aria-hidden="true"></span>
          {agent}
        </a>
        {fresh && <span class="badge-new">New</span>}
        <span class="sep" aria-hidden="true">·</span>
        {sourceUrl ? (
          <a class="source-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">{source}</a>
        ) : (
          <span>{source}</span>
        )}
        <span class="sep" aria-hidden="true">·</span>
        <span>{dateStr}</span>
      </div>
      <div class="case-actions">
        {showPromptLink && <a class="chip-btn" href={promptHref}>查看 Prompt</a>}
        <button type="button" class="chip-btn" data-share-title={title} data-share-url={href}>分享</button>
        {caseSlug && (
          <a class="chip-btn" href={`/sponsor/?case=${encodeURIComponent(caseSlug)}#listing`} title="Boost this case">推广此用例</a>
        )}
      </div>
    </div>
    {caseSlug && <VoteButton id={caseSlug} />}
  </article>
</li>
